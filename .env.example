# Copy this file to `.env.development` (for `npm start`) or `.env.production`
# (for `npm run build`) and fill in the values for your environment.

# Base URL of the Contract Wisor API. The app appends `/api` paths to this base.
REACT_APP_API_URL=http://localhost:8080/api

# Temporal Web UI URL used by the workflow page.
REACT_APP_TEMPORAL_IO_URL=http://localhost:8088/namespaces/default/workflows
